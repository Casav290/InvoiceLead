# Base Neon (chaîne « pooled » pour l'application). En local : postgres://postgres@localhost:5432/invoicelead_dev
DATABASE_URL=

# Adresse publique de l'application, sans barre finale
APP_URL=http://localhost:3000

# Secret de 32 caractères au moins : signature des cookies et chiffrement des jetons (openssl rand -base64 32)
SESSION_SECRET=

# Compte Lead (fournisseur d'identité de la famille, hébergé par CRMlead)
LEAD_ID_ISSUER=https://crmlead.io
LEAD_ID_CLIENT_ID=invoicelead
LEAD_ID_CLIENT_SECRET=
LEAD_ID_REDIRECT_URI=http://localhost:3000/auth/lead/callback
LEAD_ID_APP=invoicelead
