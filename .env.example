# Base Neon (chaîne « pooled » pour l'application). En local : postgres://postgres@localhost:5432/invoicelead_dev
DATABASE_URL=

# Adresse publique de l'application, sans barre finale
APP_URL=http://localhost:3000

# Secret de 32 caractères au moins : signature des cookies et chiffrement des jetons (openssl rand -base64 32)
SESSION_SECRET=

# Compte Lead (fournisseur d'identité de la famille, hébergé par CRMlead)
LEAD_ID_ISSUER=https://crmlead.io
LEAD_ID_CLIENT_ID=invoicelead
LEAD_ID_CLIENT_SECRET=
LEAD_ID_REDIRECT_URI=http://localhost:3000/auth/lead/callback
LEAD_ID_APP=invoicelead

# Envoi des e-mails (facultatif) : clé API Resend et expéditeur
RESEND_API_KEY=
EMAIL_FROM="InvoiceLead <factures@invoicelead.io>"

# Assistant comptable (facultatif) : API compatible OpenAI, Z.ai GLM par défaut
AI_API_KEY=
# AI_BASE_URL=https://api.z.ai/api/paas/v4
# AI_MODEL=glm-4.6

# Tâche quotidienne Vercel (factures récurrentes) : 32 caractères aléatoires
CRON_SECRET=
# Bêta privée : organisations Lead, adresses ou domaines (@fidu.ch), séparés par des virgules. Vide : ouvert.
BETA_ALLOWLIST=
# Adresse qui reçoit une copie des avis envoyés depuis l'application.
FEEDBACK_EMAIL=

# Paiement en ligne (Stripe Connect, voir docs/STRIPE.md). Sans ces variables, rien n'est proposé.
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=

# Abonnement InvoiceLead (Pro, Pro+), payé dans InvoiceLead et valable ici seulement (docs/ABONNEMENT.md).
# Compte Stripe de la famille Lead, sans rapport avec Stripe Connect ci-dessus : autres variables,
# webhook /api/billing/webhook avec son propre secret. Production seulement, jamais en Preview.
STRIPE_BILLING_SECRET_KEY=
STRIPE_BILLING_WEBHOOK_SECRET=
STRIPE_BILLING_PRICE_PRO_MONTHLY=
STRIPE_BILLING_PRICE_PRO_YEARLY=
STRIPE_BILLING_PRICE_PROPLUS_MONTHLY=
STRIPE_BILLING_PRICE_PROPLUS_YEARLY=
STRIPE_BILLING_PORTAL_CONFIGURATION=

# Réception des factures électroniques en France par la plateforme agréée B2Brouter (docs/RECEPTION-FR.md).
# Clé du groupe d'intégration InvoiceLead ; « test_… » pour le bac à sable. Vide : inscription indisponible.
B2BROUTER_API_KEY=
# B2BROUTER_API_URL=https://api.b2brouter.net
# B2BROUTER_API_VERSION=2026-06-26
